{
  "name": "cycle-v1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "harness/*",
      "apps/*",
      "tools/*"
    ],
    "catalog": {
      "@agentclientprotocol/sdk": "2.7.0",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "build": "bun run --cwd apps/daemon build && bun run --cwd apps/desktop build",
    "start": "bun run --cwd apps/desktop start",
    "check": "bun scripts/check.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.model.json && tsc -p tsconfig.renderer.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "bun test",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:integration": "bun scripts/integration.ts",
    "test:browser": "bun run --cwd packages/ui test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
