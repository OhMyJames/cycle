{
  "name": "cycle",
  "private": true,
  "workspaces": [
    "apps/*",
    "harness/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun run --filter @cycle/desktop dev",
    "dev:daemon": "bun run --filter @cycle/daemon dev",
    "web": "bun run scripts/web.ts",
    "demo": "bun run --filter @cycle/desktop build && bun run apps/daemon/test/integration/demo.ts",
    "build": "bun run --filter @cycle/desktop build",
    "desktop:package": "bun run apps/desktop/src/package/main.ts",
    "desktop:install": "bun run apps/desktop/src/install/main.ts",
    "desktop:release-assets": "bun run apps/desktop/src/package/release.ts",
    "check": "bun run scripts/check.ts",
    "boundaries": "bun run scripts/check-boundaries.ts",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test --timeout=200 --pass-with-no-tests --path-ignore-patterns=**/test/integration/** --path-ignore-patterns=**/dist/**",
    "test:integration": "bun run scripts/verify.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "electron"
  ]
}
